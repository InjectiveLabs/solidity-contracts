################################################################################
# Localhost setup
################################################################################

# Network
ETH_URL=http://localhost:8545
INJ_URL=http://localhost:26657
GRPC_URL=localhost:9900
CHAIN_ID=injective-1


# User
USER=user1
USER_MNEMONIC="copper push brief egg scan entry inform record adjust fossil boss egg comic alien upon aspect dry avoid interest fury window hint race symptom"
USER_PWD=12345678
# Chain home of demos/localnet/start.sh. To use another one, export the same
# absolute INJHOME in the shell that runs start.sh and the demos.
INJHOME="${INJHOME:-$(cd ../.. && pwd)/.injectived}"
case "$INJHOME" in
    /*) ;;
    *) echo "INJHOME must be an absolute path, got: $INJHOME" >&2; exit 1 ;;
esac
